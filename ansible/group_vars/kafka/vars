---

ansible_user: ec2-user

kafka_advertised_host: localhost
kafka_controller_quorum_bootstrap_servers: localhost:9093
kafka_heap_opts: "-Xmx1G -Xms1G"
kafka_min_insync_replicas: 1
kafka_node_id: 1
kafka_replication_factor: 1
kafka_sha512: "acb9961f7ec72f5ff1544afdfbcca39030f2c9ca0d80e8466cf961bd83ae2030bafc28d2577f3f1a099b39c06e6252b8886c1eaf6477f2a2aca8be8b68c0b25e"
kafka_version: "4.2.2"

logrotate_options:
  - daily
  - rotate 7
  - create
  - dateext
  - compress

logrotate_btmp_enable: true
logrotate_btmp:
  logs:
    - /var/log/btmp
  options:
    - missingok
    - monthly
    - create 0600 root utmp
    - rotate 1

logrotate_wtmp_enable: true
logrotate_wtmp:
  logs:
    - /var/log/wtmp
  options:
    - monthly
    - create 0664 root utmp
    - minsize 1M
    - rotate 1

logrotate_applications:
  - name: kafka
    definitions:
      - logs:
          - /var/log/kafka/*.log
        options:
          - daily
          - rotate 7
          - missingok
          - notifempty
          - compress
          - copytruncate

resource_limits_remove_existing: true

# We're not using scala but...
# (scala-version)-(kafka-version)
scala_version: "2.13"

volume_mounts:
  - device: /dev/xvdb
    file_system_type: xfs
    logical_volume: data
    volume_group: kafka
    mount_point: /data/kafka
